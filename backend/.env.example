# Environment mode: development / production
APP_ENV=development

# Maximum allowed file upload size in megabytes
MAX_FILE_SIZE_MB=10

# Allowed CORS origins for frontend integration (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Path to Tesseract OCR executable if not in system PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=
